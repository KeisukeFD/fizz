{
  "openapi": "3.2.1",
  "info": {
    "title": "Fizz OAS 3.2.1 renderer spike",
    "version": "0.0.1",
    "description": "Hand-made document exercising 3.1/3.2 features for renderer compatibility checks."
  },
  "tags": [
    {
      "name": "pets",
      "summary": "Pets",
      "description": "Operations about pets."
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "tags": ["pets"],
        "operationId": "listPets",
        "summary": "List pets",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "A list of pets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Pet"}
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        },
        "x-spike-extension": {"note": "vendor extension"}
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {
            "type": ["string", "null"],
            "examples": ["Rex", "Felix"]
          },
          "owner": {
            "$ref": "#/components/schemas/Owner",
            "description": "Sibling description next to a $ref."
          },
          "mentor": {
            "anyOf": [
              {"$ref": "#/components/schemas/Owner"},
              {"type": "null"}
            ]
          },
          "avatar": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "image/png"
          }
        }
      },
      "Owner": {
        "type": "object",
        "properties": {
          "name": {"type": "string"}
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {"type": "string"}
        }
      }
    }
  }
}
