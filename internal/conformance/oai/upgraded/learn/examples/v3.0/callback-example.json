{
  "info": {
    "title": "Callback Example",
    "version": "1.0.0"
  },
  "openapi": "3.2.1",
  "paths": {
    "/streams": {
      "post": {
        "callbacks": {
          "onData": {
            "{$request.query.callbackUrl}/data": {
              "post": {
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "properties": {
                          "timestamp": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "userData": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    }
                  },
                  "description": "subscription payload"
                },
                "responses": {
                  "202": {
                    "description": "Your server implementation should return this HTTP status code\nif the data was received successfully\n"
                  },
                  "204": {
                    "description": "Your server should return this HTTP status code if no longer interested\nin further updates\n"
                  }
                }
              }
            }
          }
        },
        "description": "subscribes a client to receive out-of-band data",
        "parameters": [
          {
            "description": "the location where data will be sent.  Must be network accessible\nby the source server\n",
            "in": "query",
            "name": "callbackUrl",
            "required": true,
            "schema": {
              "example": "https://tonys-server.com",
              "format": "uri",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "subscription information",
                  "properties": {
                    "subscriptionId": {
                      "description": "this unique identifier allows management of the subscription",
                      "example": "2531329f-fb09-4ef7-887e-84e648214436",
                      "type": "string"
                    }
                  },
                  "required": [
                    "subscriptionId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "subscription successfully created"
          }
        }
      }
    }
  }
}
