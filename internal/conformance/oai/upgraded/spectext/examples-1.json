{
  "info": {
    "title": "spec text examples-1",
    "version": "1.0.0"
  },
  "openapi": "3.2.1",
  "paths": {
    "/users/{id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "uuid": {
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "the user being returned",
            "links": {
              "address": {
                "operationId": "getUserAddress",
                "parameters": {
                  "userid": "$request.path.id"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "description": "the user identifier, as userId",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/users/{userid}/address": {
      "get": {
        "operationId": "getUserAddress",
        "responses": {
          "200": {
            "description": "the user's address"
          }
        }
      },
      "parameters": [
        {
          "description": "the user identifier, as userId",
          "in": "path",
          "name": "userid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  }
}
