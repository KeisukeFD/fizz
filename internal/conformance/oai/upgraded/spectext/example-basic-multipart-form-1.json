{
  "info": {
    "title": "spec text example-basic-multipart-form-1",
    "version": "1.0.0"
  },
  "openapi": "3.2.1",
  "paths": {
    "/example": {
      "get": {
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "addresses": {
                    "items": {
                      "$ref": "#/components/schemas/Address"
                    },
                    "type": "array"
                  },
                  "id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "profileImage": {}
                },
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
