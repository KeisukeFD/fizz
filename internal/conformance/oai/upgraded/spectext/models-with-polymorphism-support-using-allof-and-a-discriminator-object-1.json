{
  "components": {
    "schemas": {
      "Cat": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pet"
          },
          {
            "properties": {
              "huntingSkill": {
                "description": "The measured skill for hunting",
                "enum": [
                  "clueless",
                  "lazy",
                  "adventurous",
                  "aggressive"
                ],
                "type": "string"
              }
            },
            "required": [
              "huntingSkill"
            ],
            "type": "object"
          }
        ],
        "description": "A representation of a cat"
      },
      "Dog": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pet"
          },
          {
            "properties": {
              "packSize": {
                "default": 0,
                "description": "the size of the pack the dog is from",
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "packSize"
            ],
            "type": "object"
          }
        ],
        "description": "A representation of a dog"
      },
      "Pet": {
        "discriminator": {
          "propertyName": "petType"
        },
        "properties": {
          "name": {
            "type": "string"
          },
          "petType": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "petType"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "spec text models-with-polymorphism-support-using-allof-and-a-discriminator-object-1",
