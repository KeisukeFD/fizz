        "name": "limit",
        "required": true,
        "schema": {
          "format": "int32",
          "type": "integer"
        }
      },
      "skipParam": {
        "description": "number of items to skip",
        "in": "query",
        "name": "skip",
        "required": true,
        "schema": {
          "format": "int32",
          "type": "integer"
        }
      }
    },
    "responses": {
      "GeneralError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GeneralError"
            }
          }
        },
        "description": "General Error"
      },
      "IllegalInput": {
        "description": "Illegal input for operation."
      },
      "NotFound": {
        "description": "Entity not found."
      }
    },
    "schemas": {
