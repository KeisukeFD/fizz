                "dataValue": {
                  "bar": true,
                  "foo": "a + b"
                },
                "description": "Note handling of spaces and \"+\" per media type.",
                "serializedValue": "foo=a+%2B+b&bar=true"
              }
            },
            "schema": {
              "properties": {
                "bar": {
                  "type": "boolean"
                },
                "foo": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "examples": {
          "spacesAndPluses": {
            "dataValue": {
              "bar": true,
              "foo": "a + b"
            },
            "description": "Note that no additional percent encoding is done, as this\nmedia type is URI query string-ready by definition.\n",
            "serializedValue": "foo=a+%2B+b&bar=true"
          }
        },
        "in": "querystring",
        "name": "metadata"
      }
    }
