{
  "components": {
    "schemas": {
      "Cat": {
        "description": "A pet cat",
        "properties": {
          "huntingSkill": {
            "description": "The measured skill for hunting",
            "enum": [
              "clueless",
              "lazy",
              "adventurous",
              "aggressive"
            ],
            "type": "string"
          },
          "petType": {
            "const": "cat"
          }
        },
        "required": [
          "huntingSkill"
        ],
        "type": "object"
      },
      "Dog": {
        "description": "A pet dog",
        "properties": {
          "packSize": {
            "default": 0,
            "description": "the size of the pack the dog is from",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "petType": {
            "const": "dog"
          }
        },
        "required": [
          "petType",
          "packSize"
        ],
        "type": "object"
      },
      "Pet": {
        "discriminator": {
          "mapping": {
            "cat": "#/components/schemas/Cat",
            "dog": "#/components/schemas/Dog"
          },
          "propertyName": "petType"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/Cat"
          },
          {
            "$ref": "#/components/schemas/Dog"
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "petType"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "spec text models-with-polymorphism-support-and-a-discriminator-object-1",
    "version": "1.0.0"
  },
  "openapi": "3.2.1"
}
